<Window x:Class="Triangle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка треугольника" Height="250" Width="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
            <Label Content="Сторона A:" Width="80"/>
            <TextBox x:Name="SideA" Width="100"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <Label Content="Сторона B:" Width="80"/>
            <TextBox x:Name="SideB" Width="100"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <Label Content="Сторона C:" Width="80"/>
            <TextBox x:Name="SideC" Width="100"/>
        </StackPanel>

        <!-- Кнопка -->
        <Button Grid.Row="3" Content="Проверить" Click="CheckButton_Click" 
                HorizontalAlignment="Left" Margin="0,10" Padding="10,5"/>

        <!-- Результат -->
        <TextBlock x:Name="ResultText" Grid.Row="4" TextWrapping="Wrap" 
                   FontWeight="Bold" Foreground="DarkBlue" Margin="0,10,0,0"/>
    </Grid>
</Window>
